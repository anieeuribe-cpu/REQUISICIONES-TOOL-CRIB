# DATA_MODE=mock permite correr `npm run dev` sin tenant real (demo/desarrollo).
# DATA_MODE=sharepoint usa las listas reales de SharePoint (producción).
DATA_MODE=mock

# --- Solo necesarias cuando DATA_MODE=sharepoint ---
# Credenciales de la aplicación registrada en Microsoft Entra ID
# (ver docs/SETUP-SHAREPOINT.md, seccion "Registro de aplicacion").
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Sitio de SharePoint donde viven las listas.
SHAREPOINT_SITE_URL=https://empresa.sharepoint.com/sites/ToolCrib
SHAREPOINT_SITE_ID=empresa.sharepoint.com,00000000-0000-0000-0000-000000000000,00000000-0000-0000-0000-000000000000

# Nombres (Title) de las listas. Cambia solo si usaste otros nombres al crearlas.
SP_LIST_REQUISICIONES=Requisiciones
SP_LIST_RENGLONES=RequisicionRenglones
SP_LIST_CATALOGO=CatalogoPartes
SP_LIST_APROBADORES=Aprobadores
SP_LIST_TIPOCAMBIO=TipoCambio
SP_LIST_ROLES=RolesUsuarios

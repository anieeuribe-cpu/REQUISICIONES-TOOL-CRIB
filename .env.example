# DATA_MODE=mock permite correr `npm run dev` sin tenant real (demo/desarrollo).
# DATA_MODE=sharepoint usa las listas reales de SharePoint, a través del
# flujo de Power Automate (ver docs/POWER-AUTOMATE-API-FLOW.md) — no requiere
# registrar ninguna app en Azure/Entra ID ni permisos de administrador de IT.
DATA_MODE=mock

# --- Solo necesaria cuando DATA_MODE=sharepoint ---
# URL del disparador "Cuando se recibe una solicitud HTTP" del flujo
# ToolCrib-API en Power Automate. Se obtiene al guardar el flujo, en el
# propio paso del disparador ("URL de HTTP POST").
POWER_AUTOMATE_FLOW_URL=
